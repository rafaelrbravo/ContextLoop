{
  "manifest_version": 3,
  "name": "ChatGPT Prompt Launcher",
  "version": "0.19.99",
  "description": "Prompt launcher for ChatGPT with per-prompt colors, bookmark launchers, and working/ready tab indicators.",
  "permissions": [
    "storage",
    "bookmarks",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*"
  ],
  "action": {
    "default_title": "Prompt Launcher Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "autocontinue.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
